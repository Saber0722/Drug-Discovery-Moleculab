# MolecuLab environment — copy to .env and fill in

# Backend
APP_ENV=development
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database  (SQLite for local dev, swap to postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./moleculab.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional: Groq API (AI optimizer)
GROQ_API_KEY=

# Optional: ADMETlab 2.0 API  (fallback if DeepChem local is slow)
ADMETLAB_API_KEY=

# Optional: ESMFold public API endpoint
ESMFOLD_API_URL=https://api.esmatlas.com/foldSequence/v1/pdb/
